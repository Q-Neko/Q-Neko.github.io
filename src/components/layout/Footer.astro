---
import qnekoLogo from '../../assets/qneko_notext.jpg';
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";
---

 <!-- TODO: replace with actual content and add eurohpc etc acknowledgements etc -->
<div>
<footer>
    <div class="footer-content">
    <div class="footer-brand">
        <img src={qnekoLogo.src} alt="Q-Neko" />
        <p>{t.footer.tagline}</p>
    </div>
    <div class="footer-col">
        <h4>{t.footer.projectCol}</h4>
        <ul>
            <li><a href={t.footer.links.mission.href}>{t.footer.links.mission.label}</a></li>
            <li><a href={t.footer.links.consortium.href}>{t.footer.links.consortium.label}</a></li>
            <li><a href={t.footer.links.news.href}>{t.footer.links.news.label}</a></li>
            <li><a href={t.footer.links.results.href}>{t.footer.links.results.label}</a></li>
            <li><a href={t.footer.links.events.href}>{t.footer.links.events.label}</a></li>
        </ul>
    </div>
    <div class="footer-col">
        <h4>{t.footer.fundingCol}</h4>
        <ul>
            <li><a href={t.footer.links.horizonEurope.href}>{t.footer.links.horizonEurope.label}</a></li>
            <li><a href={t.footer.links.euroHPC.href}>{t.footer.links.euroHPC.label}</a></li>
            <li><a href={t.footer.links.japanSIP.href}>{t.footer.links.japanSIP.label}</a></li>
            <li><a href={t.footer.links.partnership.href}>{t.footer.links.partnership.label}</a></li>
        </ul>
    </div>
    <div class="footer-col">
        <h4>{t.footer.contactCol}</h4>
        <ul>
            <li><a href={t.footer.links.contacts.href}>{t.footer.links.contacts.label}</a></li>
            <li><a href={t.footer.links.media.href}>{t.footer.links.media.label}</a></li>
            <li><a href={t.footer.links.newsletter.href}>{t.footer.links.newsletter.label}</a></li>
            <li><a href={t.footer.links.linkedIn.href}>{t.footer.links.linkedIn.label}</a></li>
        </ul>
    </div>
    </div>
</footer>
<footer class="footer-middle">
    <img src="/logos/funders/funded_by_eu.png" alt="Funded by the European Union" />
    <img src="/logos/funders/eurohpc.png" alt="EuroHPC" />

    <p>
        This project received funding from the European High Performance Computing Joint Undertaking (EuroHPC JU) under the European Union's Horizon Europe framework program for research and innovation and Grant Agreement No. TODO.
    </p>

    <p>
        Views and opinions expressed are, however, those of the author(s) only and do not necessarily reflect those of the European Union or EuroHPC Joint Undertaking. Neither the European Union nor the granting authority can be held responsible for them.
    </p>

    <div class="footer-col">
        <p>Developed By Q-Neko</p>
        <p>Copyright © Q-Neko 2026</p>
        <p><a href={t.footer.links.privacyPolicy.href}>{t.footer.links.privacyPolicy.label}</a></p>
        <p><a href={t.footer.links.codeOfConduct.href}>{t.footer.links.codeOfConduct.label}</a></p>
    </div>

</footer>
<div class="footer-bottom">
    <p>{t.footer.copyright}</p>
    <div class="footer-flags">🇪🇺 🇯🇵</div>
    <p>{t.footer.coordinatedBy}</p>
</div>
<div/>
