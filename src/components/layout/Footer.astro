---
import { Image } from "astro:assets";
import qnekoLogo from "../../assets/qneko_notext.png";
import { useTranslations } from "../../i18n/index";

interface Props {
    lang: string;
    pagefindIgnore?: boolean;
}
const { lang, pagefindIgnore = false } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";
---

<div class="footer-root" data-pagefind-ignore={pagefindIgnore ? "all" : undefined}>
    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <Image src={qnekoLogo} alt={t.footer.logoAlt} width={324} height={128} loading="lazy" />
                <p>{t.footer.tagline}</p>
            </div>
            {
                t.footer.columns.map((col) => (
                    <div class="footer-col">
                        <h2>{col.heading}</h2>
                        <ul>
                            {col.links.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </footer>
    <footer class="footer-middle">
        <div class="footer-funders">
            <div class="footer-funder-logos">
                {
                    t.footer.funderLogos.map((logo) => (
                        <img src={logo.src} alt={logo.alt} />
                    ))
                }
            </div>
            <p>{t.footer.fundingStatement}</p>
            <p>{t.footer.disclaimer}</p>
        </div>
        <div class="footer-col footer-legal">
            <p>{t.footer.developedBy}</p>
            <p>{t.footer.developedCopyright}</p>
            {
                t.footer.legalLinks.map((link) => (
                    <p>
                        <a href={link.href}>{link.label}</a>
                    </p>
                ))
            }
        </div>
    </footer>
    <div class="footer-bottom">
        <p>{t.footer.copyright}</p>
        <div class="footer-flags">🇪🇺 🇯🇵</div>
        <p>{t.footer.coordinatedBy}</p>
    </div>
    <div></div>
</div>
