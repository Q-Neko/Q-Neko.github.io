---
import { useTranslations } from "../../i18n/index";
import { NewsletterFormCard } from "../ui/NewsletterFormCard";
import PreviousNewsletters from "../ui/PreviousNewsletters.astro";

interface Props {
    lang: string;
    showPreviousNewsletters?: boolean;
}
const { lang, showPreviousNewsletters } = Astro.props;
const t = useTranslations(lang);
---

<div class="default-bg">
    <div class="newsletter">
        <div class="">
            <div class="section-label">
                {t.pageContent.newsletter.sectionLabel}
            </div>
            <h2 class="section-h2">{t.pageContent.newsletter.heading}</h2>
            <p class="max-w-2xl text-ink/80 leading-relaxed mb-12">
                {t.pageContent.newsletter.intro}
            </p>
        </div>

        <NewsletterFormCard t={t} client:visible />

        {showPreviousNewsletters && <PreviousNewsletters t={t} />}
    </div>
</div>
