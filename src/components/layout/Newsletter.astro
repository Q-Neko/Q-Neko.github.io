---
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- TODO: add subscribtion logic once we have a newsletter system in place. For now, this is just a static form. -->
<div class="default-bg">
    <div class="newsletter">
        <div class="">
            <div class="section-label">{t.pageContent.newsletter.sectionLabel}</div>
            <h2 class="section-h2">{t.pageContent.newsletter.heading}</h2>
            <p class="max-w-2xl text-ink/80 leading-relaxed mb-12">{t.pageContent.newsletter.intro}</p>
        </div>
        <div class="newsletter-input">
            <input
                type="email"
                placeholder="your@email.com"
                class="grow px-4 py-3 border border-ink/20 rounded-lg bg-white font-mono text-sm focus:outline-none focus:border-blue"
            />
            <button class="btn-primary whitespace-nowrap">{t.pageContent.newsletter.subscribeCta}</button>
        </div>
    </div>
</div>
