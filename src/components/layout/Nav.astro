---
import qnekoLogo from "../../assets/qneko_nobg_notext.png";
import { NavMobile } from "./NavMobile.jsx";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "../../i18n/index";

interface Props {
    lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";

const navLinks = [
    { label: t.nav.results, href: `${base}/results` },
    { label: t.nav.news, href: `${base}/news` },
    { label: t.nav.events, href: `${base}/events` },
    { label: t.nav.media, href: `${base}/media` },
    { label: t.nav.newsletter, href: `${base}/newsletter` },
    { label: t.nav.contact, href: `${base}/contact` },
    { label: t.nav.search, href: `${base}/search` },
];

const currentPath = Astro.url.pathname;
const isJa = currentPath.startsWith("/ja");
const langSwitchHref = isJa
    ? currentPath.replace(/^\/ja/, "") || "/"
    : "/ja" + currentPath;
const langSwitchLabel = t.langSwitch.label;
---

<nav>
    <div class="nav-logo">
        <a href={`${base}/`}>
            <img src={qnekoLogo.src} alt="Q-Neko" />
        </a>
    </div>
    <ul class="nav-links">
        {
            navLinks.map(({ label, href }) => (
                <li>
                    <a href={href}>{label}</a>
                </li>
            ))
        }
    </ul>
    <span class="max-[1000px]:hidden"><LanguageSwitcher /></span>
    <NavMobile
        client:load
        navLinks={navLinks}
        langSwitchHref={langSwitchHref}
        langSwitchLabel={langSwitchLabel}
    />
</nav>
