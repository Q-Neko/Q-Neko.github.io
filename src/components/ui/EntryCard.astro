---
interface Props {
  title: string;
  description: string;
  href?: string;
  tags?: string[];
  meta?: string;
  image?: string;
  class?: string;
  style?: string;
}

const {
  title,
  description,
  href,
  tags,
  meta,
  image,
  class: className = "",
  style = "",
} = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag href={href} class={`base-card entry-card opacity-0 ${image ? "has-image" : ""} ${className}`} style={style}>
    {image && (
        <div class="entry-card-image">
            <img src={image} alt={title} loading="lazy" />
            {meta && <span class="entry-card-image-badge">{meta}</span>}
        </div>
    )}
    <div class="entry-card-body">
        {!image && meta && <div class="entry-card-meta">{meta}</div>}
        <h2>{title}</h2>
        {tags && tags.length > 0 && (
            <div class="post-card-tags">
                {tags.map((tag: string) => (
                    <span>{tag}</span>
                ))}
            </div>
        )}
        <p class="post-description">{description}</p>
    </div>
</Tag>
