---
const { country, region, name, long_name, logo } = Astro.props;
---

<div class="partner-card">
    <div class="partner-card-body">
        <div class="partner-card-text">
            <span class=`partner-region ${region.toLowerCase()}`>{region} - {country}</span>
            <div class="partner-name">{name}</div>
            <div class="partner-type">{long_name}</div>
        </div>
        {logo && <img src={logo} alt={`${name} logo`} class="partner-logo" loading="lazy" />}
    </div>
</div>
