---
interface Props {
    t: any;
}

const { t } = Astro.props;
---

<div class="mt-12">
    <h3 class="h3-label">{t.pageContent.newsletter.previousHeading}</h3>
    <div class="reveal base-card opacity-0 animate-fadeUp1 max-w-2xl">
        <p class="entry-card-empty">
            {t.pageContent.newsletter.previousComingSoon}
        </p>
    </div>
</div>
