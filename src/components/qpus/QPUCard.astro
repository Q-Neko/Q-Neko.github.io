---
const { maxQubits, qpu, class: className = "", style = "" } = Astro.props;
const barWidth = Math.min((qpu.qubits / maxQubits) * 100, 100);
---

<div class=`base-card ${className}` style={style}>
    <h2>{qpu.name}</h2>
    <p class=`partner-region ${qpu.region}`>{qpu.host}</p>
    <div class="qpu-detail">
        <span class="qpu-detail-label">Qubits</span>
        <span class="qpu-detail-value">{qpu.qubits}</span>
    </div>
    <div class="qpu-qubit-bar">
        <div class="qpu-qubit-bar-fill" style={`width: ${barWidth}%`}></div>
    </div>
    <div class="qpu-detail">
        <span class="qpu-detail-label">Topology</span>
        <span class="qpu-detail-value">{qpu.topology}</span>
    </div>
    <div class="qpu-detail">
        <span class="qpu-detail-label">Type</span>
        <span class="qpu-detail-value">{qpu.type}</span>
    </div>
</div>