---
const { tags, title, description, slug, class: className = "", style = "" } = Astro.props;
---

<a href={`/posts/${slug}`}>
    <div class={`base-card opacity-0 ${className}`} style={style}>
        <h2 class="">{title}</h2>
        <div class="post-card-tags">
            {tags.map((tag: String) => (
                <span class="post-card-tags">{tag}</span>
            ))}
        </div>
        <p class="post-description">{description}</p>
    </div>
</a>