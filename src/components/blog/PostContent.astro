---
const { post } = Astro.props;

import { render } from "astro:content";

const { Content } = await render(post);

const dateStr = post.data.date
    ? new Date(post.data.date).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })
    : null;

const searchBase = post.id.startsWith("ja/") ? "/ja/search" : "/search";
---

<div class="posts-bg" data-pagefind-meta={`title:${post.data.title}`}>
    {post.data.image && <span hidden data-pagefind-meta={`image:${post.data.image}`}></span>}
    {post.data.type && <span hidden data-pagefind-meta={`type:${post.data.type}`}></span>}
    {dateStr && <span hidden data-pagefind-meta={`date:${dateStr}`}></span>}
    {post.data.author && <span hidden data-pagefind-meta={`author:${post.data.author}`}></span>}
    <span class="sr-only">
        {post.data.title}. {post.data.description} {post.data.tags?.join(" ")}
    </span>
    <div class="post-content">
        <div class="post-meta" data-pagefind-ignore="all">
            <div class="post-meta-tags">
                {post.data.tags.map((tag: String) => (
                    <a href={`${searchBase}?q=${encodeURIComponent(String(tag))}`} class="post-tag">{tag}</a>
                ))}
            </div>
            <div class="post-meta-info">
                {dateStr && <span class="post-meta-date">{dateStr}</span>}
                {post.data.author && <span class="post-meta-sep">|</span>}
                {post.data.author && <span class="post-meta-author">{post.data.author}</span>}
            </div>
        </div>
        <Content />
    </div>
</div>
