---
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="default-bg">
    <div class="default">
        <div class="reveal">
            <div class="section-label">{t.pageContent.contact.sectionLabel}</div>
            <h2 class="section-h2">{t.pageContent.contact.heading}</h2>
            <p class="max-w-2xl text-ink/80 leading-relaxed mb-12">{t.pageContent.contact.intro}</p>
        </div>
        <div class="reveal base-card opacity-0 animate-fadeUp1 max-w-sm flex flex-col gap-4">
            <div>
                <div class="section-label">{t.pageContent.contact.coordinatorLabel}</div>
                <p class="text-ink/80">{t.pageContent.contact.coordinator}</p>
            </div>
            <div>
                <div class="section-label">{t.pageContent.contact.emailLabel}</div>
                <a href={`mailto:${t.pageContent.contact.email}`} class="font-mono text-blue hover:underline">
                    {t.pageContent.contact.email}
                </a>
            </div>
        </div>
    </div>
</div>
