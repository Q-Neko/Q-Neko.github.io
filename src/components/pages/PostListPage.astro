---
import EntryCard from "../ui/EntryCard.astro";
import Pagination from "../ui/Pagination.astro";
import { useTranslations } from "../../i18n/index";
import type { CollectionEntry } from "astro:content";

interface Props {
  lang: string;
  posts: CollectionEntry<"news">[];
}
const { lang, posts } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";

const PAGE_SIZE = 6;
const isEmpty = posts.length === 0;
const gridId = "news-grid";
---

<div class="default-bg">
    <div class="default" id="news">
        <div class="reveal">
            <div class="section-label">{t.news.sectionLabel}</div>
            <h2 class="section-h2">{t.news.heading}</h2>
            <p class="max-w-2xl text-ink/80 leading-relaxed mb-12">{t.news.pageIntro}</p>
        </div>

        {isEmpty ? (
            <div class="reveal base-card opacity-0 animate-fadeUp1 max-w-2xl">
                <p class="entry-card-empty">{t.news.comingSoon}</p>
            </div>
        ) : (
            <div>
                <div id={gridId} class="post-grid reveal">
                    {posts.map((post, idx) => (
                        <EntryCard
                            title={post.data.title}
                            description={post.data.description}
                            href={`${base}/news/${post.data.slug}`}
                            tags={post.data.tags}
                            meta={post.data.type}
                            image={post.data.image}
                            date={post.data.date}
                            class="animate-popIn"
                            style={`animation-delay: ${0.1 * (idx % PAGE_SIZE)}s`}
                        />
                    ))}
                </div>
                {posts.length > PAGE_SIZE && (
                    <Pagination
                        containerId={gridId}
                        paginationId="news"
                        pageSize={PAGE_SIZE}
                        labels={{ ...t.pagination }}
                    />
                )}
            </div>
        )}
    </div>
</div>
