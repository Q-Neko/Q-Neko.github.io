---
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="funding-bg" id="funding">
    <div class="funding">
        <div class="funding-text reveal">
            <div class="section-label">{t.funding.sectionLabel}</div>
            <h3>{t.funding.heading}</h3>
            <p>{t.funding.body}</p>
        </div>
        <div class="funding-pills reveal">
            {t.funding.pills.map((pill) => <div class="pill">{pill}</div>)}
        </div>
    </div>
</section>
