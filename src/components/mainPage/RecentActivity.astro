---
import EntryCard from "../ui/EntryCard.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";

// List which sources feed this section. Remove an entry to hide it.
const ENABLED_SOURCES = [
  "news",
  "events",
  "results",
] as const satisfies ReadonlyArray<"news" | "events" | "results">;

const MAX_ITEMS = 4;
const PDF_BASE = "/files/results/";

type Entry = {
  title: string;
  description?: string;
  date: Date;
  endDate?: Date;
  href: string;
  target?: string;
  meta: string;
  tags: string[];
  image?: string;
  source: "news" | "events" | "results";
};

const all: Entry[] = [];

const langPrefix = `${lang}/`;

if ((ENABLED_SOURCES as ReadonlyArray<string>).includes("news")) {
  const posts = await getCollection("news");
  for (const p of posts.filter(p => p.id.startsWith(langPrefix))) {
    all.push({
      title: p.data.title,
      description: p.data.description,
      date: p.data.date,
      href: `${base}/news/${p.data.slug}`,
      meta: p.data.type,
      tags: p.data.tags ?? [],
      image: p.data.image,
      source: "news",
    });
  }
}

if ((ENABLED_SOURCES as ReadonlyArray<string>).includes("events")) {
  const events = await getCollection("events");
  for (const e of events.filter(e => e.id.startsWith(langPrefix))) {
    all.push({
      title: e.data.title,
      description: e.data.description,
      date: e.data.startDate,
      endDate: e.data.endDate,
      href: `${base}/events/${e.data.slug}`,
      meta: e.data.location ?? "",
      tags: [],
      image: e.data.image,
      source: "events",
    });
  }
}

if ((ENABLED_SOURCES as ReadonlyArray<string>).includes("results")) {
  const results = await getCollection("results");
  for (const r of results.filter(r => r.id.startsWith(langPrefix))) {
    all.push({
      title: r.data.title,
      date: r.data.date,
      href: `${PDF_BASE}${r.data.pdf}`,
      target: "_blank",
      meta: t.pageContent.results.filters[r.data.type],
      tags: [],
      image: r.data.image,
      source: "results",
    });
  }
}

const recent = all
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, MAX_ITEMS);

const sourceViewAllHref: Record<"news" | "events" | "results", string> = {
  news: `${base}/news`,
  events: `${base}/events`,
  results: `${base}/results`,
};
---

{recent.length > 0 && (
  <section data-pagefind-ignore="all" id="recent-activity" class="default-bg">
    <div class="default">
      <div class="reveal recent-header">
        <div>
          <div class="section-label">{t.recentActivity.sectionLabel}</div>
          <h2 class="section-h2">{t.recentActivity.heading}</h2>
          <p class="max-w-2xl text-ink/80 leading-relaxed">{t.recentActivity.intro}</p>
        </div>
        <div class="recent-view-all-links">
          {ENABLED_SOURCES.map(src => (
            <a href={sourceViewAllHref[src]} class="btn-secondary recent-view-all">
              {t.nav[src]}
            </a>
          ))}
        </div>
      </div>
      <div class="post-grid post-grid-recent reveal mt-10">
        {recent.map((item, idx) => (
          <EntryCard
            title={item.title}
            description={item.description}
            href={item.href}
            target={item.target}
            meta={item.meta}
            tags={item.tags}
            image={item.image}
            date={item.date}
            endDate={item.endDate}
            class="animate-popIn"
            style={`animation-delay: ${0.1 * idx}s`}
          />
        ))}
      </div>
    </div>
  </section>
)}
