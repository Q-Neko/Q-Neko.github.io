---
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mission-bg" id="mission">
    <div class="mission">
        <div class="mission-text reveal">
            <div class="section-label">{t.mission.sectionLabel}</div>
            <h2 class="section-h2" style="color:white;">{t.mission.heading}</h2>
            <p class="mission-body">{t.mission.body}</p>
            <blockquote class="mission-quote">
                "{t.mission.quote}"
                <cite>{t.mission.quoteAuthor}</cite>
            </blockquote>
        </div>
        <div class="mission-pillars reveal">
            {t.mission.pillars.map((pillar, i) => (
                <div class="pillar">
                    <span class="pillar-num">{String(i + 1).padStart(2, "0")}</span>
                    <div>
                        <div class="pillar-title">{pillar.title}</div>
                        <div class="pillar-desc">{pillar.desc}</div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
