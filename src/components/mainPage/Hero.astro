---
import qnekoLogo from "../../assets/qneko_nobg_notext.png";
---

<section class="hero-bg">
    <div class="hero">
        <div class="hero-left">
            <div class="hero-label">Q-Neko</div>
            <h1 class="hero-h1">
                Quantum<br />
                <em>Acceleration</em><br />
                Across <span class="accent">Continents</span>
            </h1>
            <p class="hero-jp">ニッポン・ヨーロッパ 量子コラボレーション</p>
            <p class="hero-jp">Nippon-Europe Quantum Koraborēshon</p>
            <p class="hero-desc">
                Q-Neko unites Europe and Japan's leading research and industry
                partners to develop the next generation of quantum-enhanced
                computing solutions - bridging supercomputing with quantum
                acceleration for real societal impact.
            </p>
            <div class="flex flex-col gap-4 mt-6">
                <div class="hero-actions">
                    <a href="#mission" class="btn-primary"
                        >Explore the Project</a
                    >
                </div>
                <div class="hero-actions">
                    <a href="#consortium" class="btn-secondary">Our Partners</a>
                    <a href="/posts" class="btn-secondary">Posts</a>
                </div>
            </div>

            <h2 class="hero-h2">Resources</h2>
            <div class="hero-actions">
                <a href="/hpc" class="btn-secondary">HPC</a>
                <a href="/quantum-computers" class="btn-secondary">Quantum</a>
            </div>
        </div>
        <div class="hero-right">
            <div class="orbit-container">
                <div class="orbit-ring"></div>
                <div class="orbit-ring"></div>
                <div class="orbit-ring"></div>
                <div class="orbit-dot orbit-dot-1"></div>
                <div class="orbit-dot orbit-dot-2"></div>
                <div class="orbit-dot orbit-dot-3"></div>
                <div class="center-logo-wrap">
                    <img src={qnekoLogo.src} alt="Q-Neko Logo" />
                </div>
            </div>
            <div class="hero-stat-block">
                <div class="hero-stat">
                    <div class="hero-stat-num">16</div>
                    <div class="hero-stat-label">Partners</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num">10</div>
                    <div class="hero-stat-label">Quantum Computers</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-num">10</div>
                    <div class="hero-stat-label">Supercomputers</div>
                </div>
            </div>
        </div>
    </div>
</section>
