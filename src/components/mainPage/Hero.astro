---
import qnekoLogo from "../../assets/qneko_nobg_notext.png";
import { useTranslations } from "../../i18n/index";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === "ja" ? "/ja" : "";
---

<section class="hero-bg">
    <div class="hero">
        <div class="hero-left">
            <div class="hero-label">{t.hero.label}</div>
            <h1 class="hero-h1">
                {t.hero.headline1}<br />
                <em>{t.hero.headline2}</em><br />
                {t.hero.headline3}
            </h1>
            <p class="hero-jp">{t.hero.jpLine1}</p>
            <p class="hero-jp">{t.hero.jpLine2}</p>
            <p class="hero-desc">{t.hero.description}</p>
            <div class="flex flex-col gap-4 mt-6">
                <div class="hero-actions">
                    <a href={`${base}/#mission`} class="btn-primary">{t.hero.exploreCta}</a>
                </div>
                <div class="hero-actions">
                    <a href={`${base}/#consortium`} class="btn-secondary">{t.hero.partnersCta}</a>
                    <a href={`${base}/news`} class="btn-secondary">{t.hero.postsCta}</a>
                </div>
            </div>

        </div>
        <div class="hero-right">
            <div class="orbit-container">
                <div class="orbit-ring"></div>
                <div class="orbit-ring"></div>
                <div class="orbit-ring"></div>
                <div class="orbit-dot orbit-dot-1"></div>
                <div class="orbit-dot orbit-dot-2"></div>
                <div class="orbit-dot orbit-dot-3"></div>
                <div class="center-logo-wrap">
                    <img src={qnekoLogo.src} alt="Q-Neko Logo" />
                </div>
            </div>
            
        </div>
    </div>
</section>
