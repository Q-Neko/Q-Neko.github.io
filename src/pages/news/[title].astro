---
import PostContent from '../../components/blog/PostContent.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  const enPosts = posts.filter(p => p.id.startsWith("en/"));
  return enPosts.map(post => ({
    params: { title: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
---

<PageLayout title={post.data.type} pagefindIgnoreBanner>
    <PostContent post={post} />
</PageLayout>
