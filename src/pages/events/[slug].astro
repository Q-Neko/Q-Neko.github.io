---
import EventContent from "../../components/blog/EventContent.astro";
import { useTranslations } from "../../i18n";
import PageLayout from "../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const events = await getCollection("events");
    const enEvents = events.filter(e => e.id.startsWith("en/"));
    return enEvents.map(event => ({
        params: { slug: event.data.slug },
        props: { event },
    }));
}

const { event } = Astro.props;

const lang = Astro.currentLocale ?? "en";
const t = useTranslations(lang);
---

<PageLayout title={t.pages.events} pagefindIgnoreBanner>
    <EventContent event={event} />
</PageLayout>
