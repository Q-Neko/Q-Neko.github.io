---
import PostContent from '../../../components/blog/PostContent.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  const jaPosts = posts.filter(p => p.id.startsWith("ja/"));
  return jaPosts.map(post => ({
    params: { title: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
---

<PageLayout title={post.data.type} pagefindIgnoreBanner>
    <PostContent post={post} />
</PageLayout>
