---
import EventContent from "../../../components/blog/EventContent.astro";
import { useTranslations } from "../../../i18n";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const events = await getCollection("events");
    const jaEvents = events.filter(e => e.id.startsWith("ja/"));
    return jaEvents.map(event => ({
        params: { slug: event.data.slug },
        props: { event },
    }));
}

const { event } = Astro.props;

const lang = Astro.currentLocale ?? "ja";
const t = useTranslations(lang);
---

<PageLayout title={t.pages.events} pagefindIgnoreBanner>
    <EventContent event={event} />
</PageLayout>
