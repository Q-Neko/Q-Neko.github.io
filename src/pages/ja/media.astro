---
import PageLayout from "../../layouts/PageLayout.astro";
import MediaPage from "../../components/pages/MediaPage.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/index";

const lang = Astro.currentLocale ?? "ja";
const t = useTranslations(lang);

const pressReleases = await getCollection("pressReleases");
const mediaCoverage = await getCollection("mediaCoverage");
const brandAssets = await getCollection("brandAssets");
---

<PageLayout title={t.pages.media}>
    <MediaPage
        lang={lang}
        pressReleases={pressReleases}
        mediaCoverage={mediaCoverage}
        brandAssets={brandAssets}
    />
</PageLayout>
