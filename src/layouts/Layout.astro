---
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Nav from "../components/layout/Nav.astro";
import { CookieConsent } from "../components/layout/CookieConsent.jsx";
import { useTranslations } from "../i18n/index";
import "@fontsource-variable/exo-2";
// The default entrypoint only ships the upright style, so italics would be
// browser-synthesised slants without this second import.
import "@fontsource-variable/exo-2/wght-italic.css";
import "@fontsource-variable/noto-sans-jp";

const lang = Astro.currentLocale ?? "en";
const t = useTranslations(lang);

// Footer is the same on every page, so only let Pagefind index it on the home
// page — otherwise its text pollutes the excerpt of every search result.
const path = Astro.url.pathname.replace(/\/$/, "");
const isHome = path === "" || path === "/ja";
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta name="google-site-verification" content="kQjZHZ_upi86NdtdZe1l2c_yvDtsY2p3NdM_GFMo44c" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
			<meta
				name="description"
				content="Q-Neko unites Europe and Japan's leading research and industry partners to develop the next generation of quantum-enhanced computing solutions - bridging supercomputing with quantum acceleration for real societal impact."
			/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/qneko_notext_logo_only.jpg"
		/>
		<link rel="icon" href="/favicon.ico" />
		<!-- Exo 2 and Noto Sans JP are self-hosted via @fontsource-variable
		     (imported in the frontmatter), so no third-party Google Fonts
		     request is needed. Noto Sans JP ships ~124 unicode-range subsets,
		     so a page only fetches the subsets its CJK glyphs actually need. -->
		<!-- KaTeX only styles rendered math; load it off the critical render
		     path so it never blocks first paint on non-math pages. -->
		<link
			rel="preload"
			as="style"
			href="https://cdn.jsdelivr.net/npm/katex@0.13.0/dist/katex.min.css"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/katex@0.13.0/dist/katex.min.css"
			/>
		</noscript>
		<meta name="generator" content={Astro.generator} />
		<title>Q-Neko</title>
		<script>
			import { loadMatomo } from "../components/layout/matomo.js";
			// Defer analytics until the browser is idle so it stays off the
			// initial load's critical path (no main-thread contention during FCP/LCP).
			const startMatomo = () =>
				loadMatomo(
					import.meta.env.PUBLIC_MATOMO_URL,
					import.meta.env.PUBLIC_MATOMO_CONTAINER_ID,
				);
			if ("requestIdleCallback" in window) {
				requestIdleCallback(startMatomo);
			} else {
				setTimeout(startMatomo, 1);
			}
		</script>
	</head>
	<body class="flex flex-col min-h-screen min-w-creen">
		<div class="grid-bg"></div>
		<Nav lang={lang} />
		<main class="grow z-1 flex flex-col">
			<slot />
		</main>
		<Footer lang={lang} pagefindIgnore={!isHome} />
		<!-- <CookieConsent client:load t={{ cookies: t.cookies }} /> -->
		<script>
			// Scroll reveal
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add("visible");
						}
					});
				},
				{ threshold: 0.12 },
			);

			document
				.querySelectorAll(".reveal")
				.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
