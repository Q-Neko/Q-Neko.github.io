---
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Nav from "../components/layout/Nav.astro";
import { CookieConsent } from "../components/layout/CookieConsent.jsx";
import { useTranslations } from "../i18n/index";

const lang = Astro.currentLocale ?? "en";
const t = useTranslations(lang);

// Footer is the same on every page, so only let Pagefind index it on the home
// page — otherwise its text pollutes the excerpt of every search result.
const path = Astro.url.pathname.replace(/\/$/, "");
const isHome = path === "" || path === "/ja";
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta name="google-site-verification" content="kQjZHZ_upi86NdtdZe1l2c_yvDtsY2p3NdM_GFMo44c" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/qneko_notext_logo_only.jpg"
		/>
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.13.0/dist/katex.min.css"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Q-Neko</title>
		<script>
			import { loadMatomo } from "../components/layout/matomo.js";
			loadMatomo(
				import.meta.env.PUBLIC_MATOMO_URL,
				import.meta.env.PUBLIC_MATOMO_CONTAINER_ID,
			);
		</script>
	</head>
	<body class="flex flex-col min-h-screen min-w-creen">
		<div class="grid-bg"></div>
		<Nav lang={lang} />
		<main class="grow z-1 flex flex-col">
			<slot />
		</main>
		<Footer lang={lang} pagefindIgnore={!isHome} />
		<!-- <CookieConsent client:load t={{ cookies: t.cookies }} /> -->
		<script>
			// Scroll reveal
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add("visible");
						}
					});
				},
				{ threshold: 0.12 },
			);

			document
				.querySelectorAll(".reveal")
				.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
